# ==============================================================================
# JALASHAYA — Bengaluru Water Body Digital Twin & Satellite Simulation
# Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in your root and backend directories.
# 2. Fill in credentials when available.
# 3. The system works gracefully in offline/cached demonstration mode if
#    external satellite credentials (GEE / Sentinel Hub) are omitted.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=JALASHAYA
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=jalashaya-super-secret-production-grade-key-change-in-prod-2026
LOG_LEVEL=INFO
DEBUG=true

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_TOKEN_HERE
VITE_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY_HERE
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
VITE_APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# DATABASE & POSTGIS CONFIGURATION
# ------------------------------------------------------------------------------
# Default to SQLite file if PostgreSQL is not running locally.
# For production PostGIS, uncomment and set the PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/jalashaya
DATABASE_URL=sqlite:///./jalashaya.db
DB_ECHO=false

# ------------------------------------------------------------------------------
# GOOGLE EARTH ENGINE (GEE)
# ------------------------------------------------------------------------------
GEE_ENABLED=false
GEE_AUTH_MODE=service_account
GEE_PROJECT_ID=YOUR_GOOGLE_CLOUD_PROJECT_ID
GEE_SERVICE_ACCOUNT=YOUR_GEE_SERVICE_ACCOUNT_EMAIL
GEE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GEE_KEY_FILE_PATH=
GEE_CLIENT_ID=YOUR_GEE_CLIENT_ID

# ------------------------------------------------------------------------------
# SENTINEL HUB / COPERNICUS DATA SPACE
# ------------------------------------------------------------------------------
SENTINEL_HUB_ENABLED=false
SENTINEL_HUB_CLIENT_ID=YOUR_SENTINEL_HUB_CLIENT_ID
SENTINEL_HUB_CLIENT_SECRET=YOUR_SENTINEL_HUB_CLIENT_SECRET
COPERNICUS_API_KEY=YOUR_COPERNICUS_API_KEY

# ------------------------------------------------------------------------------
# GEOSPATIAL DATA SOURCES & ENDPOINTS
# ------------------------------------------------------------------------------
OPENSTREETMAP_OVERPASS_URL=https://overpass-api.de/api/interpreter
BBMP_DATA_SOURCE_URL=https://bbmp.gov.in/lakes
JRC_DATA_SOURCE_URL=https://global-surface-water.appspot.com

# ------------------------------------------------------------------------------
# STORAGE & CACHE
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./data
STORAGE_BUCKET=jalashaya-satellite-cache
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT=

# ------------------------------------------------------------------------------
# SCIENTIFIC PROCESSING & DETECTION CONFIGURATION
# ------------------------------------------------------------------------------
# Normalized Difference Water Index (NDWI) threshold for McFeeters formula (Green - NIR)/(Green + NIR)
# Standard McFeeters NDWI threshold is 0.0; values > 0.0 indicate clear surface water.
NDWI_THRESHOLD=0.0
MAX_CLOUD_COVERAGE=20.0
DEFAULT_OBSERVATION_WINDOW_DAYS=30
ENABLE_SATELLITE_CACHE=true
CACHE_EXPIRY_HOURS=720
DATA_PROCESSING_WORKERS=2
TARGET_PROJECTION_CRS=EPSG:32643

# ------------------------------------------------------------------------------
# OPTIONAL AI EXPLANATIONS
# ------------------------------------------------------------------------------
ENABLE_AI_EXPLANATIONS=false
GROQ_API_KEY=YOUR_GROQ_API_KEY
AI_MODEL=llama-3.3-70b-versatile
